<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sunsklys.opencode.db-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/Backups/opencode" &amp;&amp; cd "$HOME/.config/opencode" &amp;&amp; bash scripts/opencode-db-check.sh &gt;&gt; "$HOME/Backups/opencode/db-check.log" 2&gt;&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
        <string>/tmp/opencode-dbcheck-launchd.out</string>
    <key>StandardErrorPath</key>
        <string>/tmp/opencode-dbcheck-launchd.err</string>
</dict>
</plist>
