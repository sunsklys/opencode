// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "hashline_edit": true,
    "telemetry": false,
    "i18n": {
      "locale": "zh"
    },
    "disabled_providers": [
      "openai",
      "anthropic",
      "google",
      "opencode"
    ],
    "team_mode": {
      "enabled": true
    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        429,
        500,
        502,
        503,
        504,
        529
      ],
      "max_fallback_attempts": 4,
      "cooldown_seconds": 30,
      "timeout_seconds": 60,
      "notify_on_fallback": true
    },
    "model_fallback": true,
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000
    },
    "background_task": {
      "providerConcurrency": {
        "zhipuai-coding-plan": 3
      },
      "modelConcurrency": {
        "zhipuai-coding-plan/glm-5.3-flash": 3,
        "zhipuai-coding-plan/glm-4.6v": 3,
        "zhipuai-coding-plan/glm-5v-turbo": 3
      }
    },
    "experimental": {
      "task_system": true,
      "preemptive_compaction": true,
      "aggressive_truncation": true,
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",
        "turn_protection": {
          "enabled": true,
          "turns": 3
        },
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          "deduplication": {
            "enabled": true
          },
          "supersede_writes": {
            "enabled": true,
            "aggressive": false
          },
          "purge_errors": {
            "enabled": true,
            "turns": 5
          }
        }
      }
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": false,
      "planner_enabled": true,
      "replace_plan": true,
      "tdd": true
    },
    "default_mode": {
      "ultrawork": false,
      "goal": false
    },
    "goal": {
      "enabled": false,
      "auto_start": false,
      "default_max_iterations": 100
    },
    "agents": {
      "sisyphus": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "compaction": {
          "model": "zhipuai-coding-plan/glm-5.3-flash",
          "prune": true,
          "tail_turns": 6
        },
        "ultrawork": {
          "model": "zhipuai-coding-plan/glm-5.3",
          "reasoning": "max"
        },
        "model": "zhipuai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
          "zhipuai-coding-plan/glm-5.2"
        ]
      },
      "prometheus": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "compaction": {
          "model": "zhipuai-coding-plan/glm-5.3-flash",
          "prune": true,
          "tail_turns": 6
        },
        "model": "zhipuai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
          "zhipuai-coding-plan/glm-5.2"
        ]
      },
      "plan": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "compaction": {
          "model": "zhipuai-coding-plan/glm-5.3-flash",
          "prune": true,
