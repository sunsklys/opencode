        "fallback_models": [
          "zhipuai-coding-plan/glm-5.2"
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "models": [
          {
            "model": "zhipuai-coding-plan/glm-5.3-flash",
            "reasoning": "low"
          },
          "zhipuai-coding-plan/glm-5v-turbo",
          "zhipuai-coding-plan/glm-4.6v"
        ]
      },
      "ultrabrain": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "variant": "max",
        "models": [
          {
            "model": "zhipuai-coding-plan/glm-5.3",
            "reasoning": "max"
          },
          "zhipuai-coding-plan/glm-5.2"
        ]
      },
      "artistry": {
        "temperature": 0.7,
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "variant": "max",
        "models": [
          {
            "model": "zhipuai-coding-plan/glm-5.3",
            "reasoning": "max"
          },
