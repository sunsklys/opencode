      },
      "writing": {
        "temperature": 0.7,
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "variant": "low",
        "models": [
          "zhipuai-coding-plan/glm-5.3",
          "zhipuai-coding-plan/glm-5.2"
        ]
      }
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": true,
      "git_env_prefix": "GIT_MASTER=1"
    },
    "keyword_detector": {
      "enabled_expansions": [
        "ultrawork",
        "team",
        "hyperplan",
        "hyperplan-ultrawork"
      ]
    },
    "monitor": {
      "enabled": true
    },
    "babysitting": {
      "timeout_ms": 300000
    },
    "comment_checker": {
      "custom_prompt": "检查中文注释与代码一致性。中文注释需准确描述代码行为，避免英文直译凑数。检查：1) 中文表述是否符合代码实际逻辑；2) 是否有 AI 生成的空洞描述（如“这里做一些处理”）；3) 函数/类/复杂分支是否有中文文档注释。代码注释：{{comments}}"
    },
    "disabled_skills": [
      "playwright",
      "dev-browser",
      "agent-browser"
    ]
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
