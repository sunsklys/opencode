        },
        "model": "zhipuai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
          "zhipuai-coding-plan/glm-5.2"
        ]
      },
      "oracle": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "compaction": {
          "model": "zhipuai-coding-plan/glm-5.3-flash",
          "prune": true,
          "tail_turns": 6
        },
        "model": "zhipuai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
          "zhipuai-coding-plan/glm-5.2"
        ]
      },
      "metis": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "compaction": {
          "model": "zhipuai-coding-plan/glm-5.3-flash",
          "prune": true,
          "tail_turns": 6
        },
        "model": "zhipuai-coding-plan/glm-5.3",
        "reasoning": "max",
        "fallback_models": [
