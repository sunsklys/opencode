      "multimodal-looker": {
        "prompt_append": "file://~/.config/opencode/.opencode/lang-zh.md",
        "model": "zhipuai-coding-plan/glm-5.3-flash",
        "fallback_models": [
          "zhipuai-coding-plan/glm-5v-turbo",
          "zhipuai-coding-plan/glm-4.6v"
