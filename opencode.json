{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@4.19.4",
    "opencode-mem@2.25.0",
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "mcp": {
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server@0.1.5"
      ],
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZHIPU"
      }
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "web-reader": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      },
      "enabled": false
    },
    "zread": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "mermaid": {
      "type": "local",
      "command": [
        "claude-mermaid"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ]
    },
    "dbx": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@dbx-app/mcp-server@0.4"
      ]
    }
  },
  "lsp": true,
  "agent": {
    "build": { "variant": "max" },
    "plan": { "variant": "max" },
    "general": { "variant": "max" },
    "sisyphus": { "variant": "max" }
  },
  "default_agent": "sisyphus",
  "share": "manual",
  "autoupdate": true,
  "compaction": {
    "prune": true,
    "tail_turns": 6
  },
  "experimental": {
    "batch_tool": true,
    "continue_loop_on_deny": true,
    "mcp_timeout": 60000
  },
  "formatter": true,
  "instructions": [
    "{file:~/.config/opencode/.opencode/instructions.md}",
    "{file:~/.config/opencode/.opencode/dbx.md}"
  ],
  "model": "zhipuai-coding-plan/glm-5.3",
  "small_model": "zhipuai-coding-plan/glm-5.3-flash",
  "enabled_providers": [
    "zhipuai-coding-plan"
  ],
  "subagent_depth": 2,
  "shell": "zsh",
  "references": {
    "omo": {
      "repository": "code-yeongyu/oh-my-openagent",
      "branch": "dev",
      "description": "oh-my-openagent 上游仓库（agent/category schema、新功能跟踪）"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "description": "opencode CLI 上游仓库（config schema、新版本字段）"
    },
    "superpowers": {
      "repository": "obra/superpowers",
      "description": "superpowers 上游仓库（process skill 方法论：TDD/systematic-debugging/plans/code-review 等 14 个 skill）"
    }
  },
  "tool_output": {
    "max_bytes": 524288
  },
  "attachment": {
    "image": {
      "max_width": 1600,
      "max_height": 1600
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".next/**",
      "target/**",
      "build/**",
      ".turbo/**",
      ".cache/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".mypy_cache/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      "bin/**",
      "obj/**",
      "DerivedData/**",
      "vendor/**",
      "Pods/**",
      ".gradle/**",
      "coverage/**",
      "tmp/**",
      ".sveltekit/**",
      ".dart_tool/**",
      ".DS_Store",
      "*.log",
      "*.tsbuildinfo",
      "*.lintcache",
      ".idea/**",
      ".vscode/**",
      ".codegraph/**",
      ".opencode/**",
      ".omo/**",
      "tasks/**",
      ".sisyphus/**",
      ".claude/**",
      ".codex/**"
    ]
  },
  "permission": {
    "read": { "*": "allow" },
    "bash": {
      "*": "allow",
      "mkfs*": "deny",
      "dd*": "deny",
      "rm -rf /": "deny",
      "rm -fr /": "deny",
      "rm -rf ~": "deny",
      "rm -fr ~": "deny",
      "rm -rf $HOME": "deny",
      "rm -fr $HOME": "deny",
      "rm -rf /*": "deny",
      "rm -fr /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -fr ~/*": "deny",
      "rm -rf ..": "deny",
      "rm -fr ..": "deny"
    },
    "edit": { "*": "allow" }
  }
}
